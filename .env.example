# 将本文件复制为 .env，再填入你自己的模型 API 密钥。
# provider 可选：openai（官方）、aizex（OpenAI 兼容中转）、deepseek、glm。
LLM_PROVIDER=aizex
LLM_API_KEY=
LLM_BASE_URL=https://codex-api.aizex.net/v1
LLM_API_MODE=auto
LLM_MODEL=gpt-6.1-sol
LLM_MODEL_FALLBACK=gpt-6.1-sol

# 也兼容旧变量：OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL。
# 如果上面的 LLM_* 已填写，会优先使用 LLM_*。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_MODEL_FALLBACK=gpt-6.1-sol
OPENAI_REASONING_EFFORT=high

# 所有文字 Agent（含 Luna 角色）统一使用 GPT-6.1 Sol，推理强度 high。
LLM_MODEL_LUNA=gpt-6.1-sol
LLM_MODEL_SOL=gpt-6.1-sol
OPENAI_MODEL_LUNA=gpt-6.1-sol
OPENAI_MODEL_SOL=gpt-6.1-sol
OPENAI_REASONING_LUNA=high
OPENAI_REASONING_SOL=high

# 主题图：可与文案使用不同的服务。空值时沿用本机文案 API 配置。
# 图片服务须支持 OpenAI 兼容 /images/edits（多图参考），仅支持聊天的服务不可用。
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-2

# 如需同一局域网访问，可绑定局域网地址；仓库已取消访问码，建议仅在可信网络使用。
# APP_HOST=0.0.0.0
# APP_PORT=8000
